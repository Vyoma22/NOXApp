<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nox_cream_bg"
    android:orientation="vertical">

    <!-- Conversation header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/chatBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/nox_dark_green" />

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/nox_card_green"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/chatAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="AC"
                android:textColor="@color/nox_dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatPersonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Amazon Cat"
                android:textColor="@color/nox_dark_green"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MacBook Air · $550"
                android:textColor="@color/nox_subtext"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Temporary item thumbnail placeholder -->

        <!-- Product photo for this conversation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="40dp"
            app:cardCornerRadius="7dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/nox_chip_bg">

            <ImageView
                android:id="@+id/chatItemThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Listing product photo" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Seller-only button. Hidden until role checking is added. -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmSaleButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Confirm Sale"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/nox_primary_green"
            app:cornerRadius="10dp"
            tools:visibility="visible" />


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nox_search_stroke" />

    <!-- Messages area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatMessagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <!-- Seller confirmation card: hidden until requested -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chatSellerConfirmCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/nox_chip_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Finished the exchange?"
                android:textColor="@color/nox_dark_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="If you've handed over the item and received the payment, confirm the sale to complete the transaction."
                android:textColor="@color/nox_dark_green"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendSaleConfirmationButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✓ Confirm Sale"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/nox_primary_green"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Message input -->
    <LinearLayout
        android:id="@+id/chatInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/chatMessageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_search_box"
            android:hint="Type a message..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/nox_dark_green"
            android:textColorHint="@color/nox_subtext"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chatSendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Send message"
            android:gravity="center"
            android:text="➤"
            android:textColor="@color/nox_dark_green"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Reuse the existing NOX bottom navigation -->
    <include
        android:id="@+id/chatBottomNav"
        layout="@layout/nav_bar" />

</LinearLayout>
