<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nox_cream_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/detailClose"
            android:textColor="@color/nox_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/detailClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="Close"
            app:tint="@color/nox_dark_green"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </RelativeLayout>

    <TextView
        android:id="@+id/detailPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/nox_dark_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/nox_accent_pink"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/nox_dark_green"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@color/nox_card_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/nox_dark_green"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/nox_dark_green"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/detailLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@android:drawable/ic_dialog_map"
        android:drawablePadding="8dp"
        android:textColor="@color/nox_subtext"
        android:textSize="13sp" />

    <Button
        android:id="@+id/messageSellerButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/nox_primary_green"
        android:text="Message Seller"
        android:textColor="@color/white"
        android:textSize="14sp" />
</LinearLayout>