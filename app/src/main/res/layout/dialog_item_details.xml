<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/detailClose"
            android:textColor="@color/nox_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/detailClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/nox_dark_green" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/detailImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_listing_image"
        android:clipToOutline="true"
        android:contentDescription="Listing photo"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/detailPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/nox_dark_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/nox_accent_pink"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/nox_dark_green"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@color/nox_card_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/nox_dark_green"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/nox_dark_green"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/detailLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_map_pin"
        android:drawablePadding="8dp"
        android:drawableTint="@color/nox_subtext"
        android:textColor="@color/nox_subtext"
        android:textSize="13sp" />

    <!-- Only shown to the student who owns the listing. -->
    <LinearLayout
        android:id="@+id/ownerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editListingButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/listing_edit"
            android:textColor="@color/nox_primary_green"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/nox_primary_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteListingButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/listing_delete"
            android:textColor="@color/nox_error"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@color/nox_error" />
    </LinearLayout>

    <Button
        android:id="@+id/messageSellerButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/nox_primary_green"
        android:text="@string/detail_message_seller"
        android:textColor="@color/white"
        android:textSize="14sp" />
</LinearLayout>