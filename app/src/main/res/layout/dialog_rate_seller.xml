<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ratingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate the Seller"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="How was your experience with this seller?"
        android:textSize="15sp"
        android:gravity="center" />

    <RatingBar
        android:id="@+id/sellerRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:numStars="5"
        android:stepSize="1"
        android:rating="0"
        android:isIndicator="false" />

    <TextView
        android:id="@+id/ratingRequiredText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select 1 to 5 stars (required)"
        android:gravity="center"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Write a review (optional)"
        android:textSize="15sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/sellerReviewInput"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:gravity="top|start"
        android:padding="12dp"
        android:hint="Share your experience..."
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="500"
        android:textSize="14sp" />

</LinearLayout>
