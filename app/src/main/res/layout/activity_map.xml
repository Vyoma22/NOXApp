<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/nox_cream_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mapGuideline" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.52" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/campusMap" android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/mapGuideline"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <ImageView android:id="@+id/mapCenterPin" android:layout_width="32dp" android:layout_height="40dp"
        android:src="@drawable/ic_map_center_pin" android:contentDescription="@string/map_center"
        android:translationY="-20dp" android:clickable="false" android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/campusMap" app:layout_constraintBottom_toBottomOf="@id/campusMap"
        app:layout_constraintStart_toStartOf="@id/campusMap" app:layout_constraintEnd_toEndOf="@id/campusMap" />

    <LinearLayout android:id="@+id/mapTopBar" android:layout_width="0dp" android:layout_height="56dp"
        android:layout_margin="12dp" android:background="@drawable/rounded_search_box"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/mapBackButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
            android:src="@drawable/ic_arrow_back" android:contentDescription="@string/map_back"
            app:tint="@color/nox_dark_green" />
        <EditText android:id="@+id/locationSearchInput" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:background="@null" android:hint="@string/location_search_hint"
            android:inputType="textCapWords" android:imeOptions="actionSearch|flagNoExtractUi"
            android:singleLine="true" android:maxLength="200" android:autofillHints="postalAddress"
            android:paddingStart="4dp" android:paddingEnd="4dp" android:textSize="14sp"
            android:textColor="@color/nox_dark_green" android:textColorHint="@color/nox_subtext" />
        <ImageButton android:id="@+id/locationSearchButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
            android:src="@android:drawable/ic_menu_search" android:contentDescription="@string/location_search_action"
            app:tint="@color/nox_primary_green" />
        <ImageButton android:id="@+id/myLocationButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
            android:src="@android:drawable/ic_menu_mylocation" android:contentDescription="@string/my_location"
            app:tint="@color/nox_primary_green" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mapItemsScroll" android:layout_width="0dp" android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="@id/mapGuideline" app:layout_constraintBottom_toTopOf="@id/mapBottomNav"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/radiusCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/nox_field_bg" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/locationSearchStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:visibility="gone" android:layout_marginBottom="8dp" android:accessibilityLiveRegion="polite"
                        android:textColor="@color/nox_subtext" android:textSize="14sp" />
                    <TextView android:id="@+id/radiusLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:labelFor="@id/radiusSlider" android:textColor="@color/nox_dark_green"
                        android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.slider.Slider android:id="@+id/radiusSlider"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:valueFrom="0.5" android:valueTo="10.0" android:stepSize="0.5" android:value="2.0"
                        app:thumbColor="@color/nox_primary_green" app:trackColorActive="@color/nox_primary_green"
                        app:trackColorInactive="@color/nox_chip_bg" app:tickVisible="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchAreaButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp"
                        android:text="@string/browse_items_in_area" android:textAllCaps="false" android:textColor="@color/white"
                        app:backgroundTint="@color/nox_primary_green" app:cornerRadius="24dp"
                        app:icon="@drawable/ic_map_pin" app:iconTint="@color/white" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/savePreferenceButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:visibility="gone"
                        android:text="@string/save_preference" android:textAllCaps="false" android:textColor="@color/white"
                        app:backgroundTint="@color/nox_primary_green" app:cornerRadius="24dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/mapBottomNav" android:layout_width="0dp" android:layout_height="64dp"
        android:background="@color/nox_nav_bg" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/mNavHome" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no"
                android:src="@android:drawable/ic_menu_rotate" app:tint="@color/nox_dark_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/map_nav_home" android:textColor="@color/nox_dark_green" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mNavBrowse" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no"
                android:src="@android:drawable/ic_menu_search" app:tint="@color/nox_primary_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"
                android:text="@string/map_nav_browse" android:textColor="@color/nox_primary_green" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mNavPost" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no"
                android:src="@android:drawable/ic_input_add" app:tint="@color/nox_dark_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/map_nav_post" android:textColor="@color/nox_dark_green" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mNavChat" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no"
                android:src="@android:drawable/stat_notify_chat" app:tint="@color/nox_dark_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/map_nav_chat" android:textColor="@color/nox_dark_green" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mNavProfile" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no"
                android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/nox_dark_green" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/map_nav_profile" android:textColor="@color/nox_dark_green" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
