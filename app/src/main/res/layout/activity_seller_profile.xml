<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sellerProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nox_cream_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sellerProfileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Back button header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/sellerProfileBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/seller_profile_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/nox_dark_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/seller_profile_title"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Circular avatar -->
            <androidx.cardview.widget.CardView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/nox_card_green"
                app:cardCornerRadius="45dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/sellerAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/seller_profile_avatar"
                    android:gravity="center"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- Name, school, and verified badge -->
            <TextView
                android:id="@+id/sellerNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/nox_dark_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sellerSchoolText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nox_subtext"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sellerVerifiedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/nox_chip_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/seller_verified_badge"
                android:textColor="@color/nox_accent_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Two pill tabs: Listings | Sold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sellerTabListings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/seller_tab_listings"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@color/nox_primary_green"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sellerTabSold"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/seller_tab_sold"
                    android:textAllCaps="false"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="14sp"
                    app:backgroundTint="@color/nox_chip_bg"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <!-- Search -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_search_box">

                <EditText
                    android:id="@+id/sellerSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/nox_subtext"
                    android:hint="@string/seller_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/nox_dark_green"
                    android:textColorHint="@color/nox_subtext"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/sellerSearchClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_search"
                    android:padding="14dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/nox_subtext" />
            </FrameLayout>

            <!-- Category filter -->
            <Spinner
                android:id="@+id/sellerCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/spinner_bg"
                android:contentDescription="@string/seller_category_filter"
                android:paddingStart="16dp"
                android:paddingEnd="36dp"
                android:popupBackground="@color/nox_field_bg" />

            <!-- Result count and loading spinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sellerResultCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/nox_subtext"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/sellerLoading"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/nox_primary_green"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Grid of this seller's items -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sellerRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Error state with retry -->
            <LinearLayout
                android:id="@+id/sellerErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_error_title"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/home_error_hint"
                    android:textColor="@color/nox_subtext"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/sellerErrorRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/nox_primary_green"
                    android:text="@string/retry"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Empty state: no items on this tab, or no filter matches -->
            <TextView
                android:id="@+id/sellerEmptyNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/nox_subtext"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
