<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF6EA"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <ImageButton
            android:id="@+id/btnAddImage"
            android:layout_width="350dp"
            android:layout_height="140dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="16dp"
            android:background="#88B897"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_camera" />

        <TextView
            android:id="@+id/btnText1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Photos/Videos"
            android:textSize="16dp"
            app:layout_constraintBottom_toTopOf="@+id/btnText2"
            app:layout_constraintEnd_toEndOf="@+id/btnAddImage"
            app:layout_constraintStart_toStartOf="@+id/btnAddImage"
            app:layout_constraintTop_toTopOf="@+id/btnAddImage"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/btnText2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Up to 5 files"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnAddImage"
            app:layout_constraintEnd_toEndOf="@+id/btnAddImage"
            app:layout_constraintStart_toStartOf="@+id/btnAddImage" />

        <TextView
            android:id="@+id/hdrTitle"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="310dp"
            android:layout_marginBottom="12dp"
            android:text="Title"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAddImage" />

        <TextView
            android:id="@+id/hdrCategory"
            android:layout_width="75dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="270dp"
            android:layout_marginBottom="12dp"
            android:text="Category"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etItmName" />

        <TextView
            android:id="@+id/hdrPrice"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="300dp"
            android:layout_marginBottom="12dp"
            android:text="Price"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spiCategory" />

        <TextView
            android:id="@+id/hdrCondition"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="270dp"
            android:layout_marginBottom="12dp"
            android:text="Condition"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etPrice" />

        <TextView
            android:id="@+id/hdrDescription"
            android:layout_width="100dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="260dp"
            android:layout_marginBottom="12dp"
            android:text="Description"
            android:textSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radgroupCondition" />

        <TextView
            android:id="@+id/hdrLocation"
            android:layout_width="140dp"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="220dp"
            android:layout_marginBottom="12dp"
            android:text="Pickup Location"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etDescription" />

        <EditText
            android:id="@+id/etItmName"
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:background="#FFFCF6"
            android:ems="10"
            android:hint="e.g. Desk chair, MacBook, Textbook..."
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrTitle" />

        <Spinner
            android:id="@+id/spiCategory"
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFCF6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrCategory" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFCF6"
            android:ems="10"
            android:hint="$ 0.00"
            android:inputType="numberDecimal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrPrice" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFCF6"
            android:ems="10"
            android:hint="Tell us more about your item..."
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrDescription" />

        <Spinner
            android:id="@+id/spiLocation"
            android:layout_width="360dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFCF6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrLocation" />

        <RadioGroup
            android:id="@+id/radgroupCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hdrCondition">

            <RadioButton
                android:id="@+id/radBtnNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFCF6"
                android:layout_margin="12dp"
                android:layout_weight="1"
                android:checked="false"
                android:text="New" />

            <RadioButton
                android:id="@+id/radBtnLikeNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFCF6"
                android:layout_margin="12dp"
                android:layout_weight="1"
                android:checked="true"
                android:text="Like New" />

            <RadioButton
                android:id="@+id/radBtnUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFCF6"
                android:layout_margin="12dp"
                android:layout_weight="1"
                android:checked="false"
                android:text="Used" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPostList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Post Listing"
            android:background="#2F6B4F"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spiLocation" />

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:background="#88B897"
            app:layout_constraintBottom_toTopOf="@+id/btnAddImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_camera" />

        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@color/nox_nav_bg"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5"
            app:layout_constraintTop_toBottomOf="@id/btnPostList">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Home"
                    android:tint="@color/nox_primary_green"
                    android:src="@android:drawable/ic_menu_rotate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="@color/nox_primary_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBrowse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Browse"
                    android:tint="@color/nox_dark_green"
                    android:src="@android:drawable/ic_menu_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Post"
                    android:tint="@color/nox_dark_green"
                    android:src="@android:drawable/ic_input_add" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Chat"
                    android:tint="@color/nox_dark_green"
                    android:src="@android:drawable/stat_notify_chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Profile"
                    android:tint="@color/nox_dark_green"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>