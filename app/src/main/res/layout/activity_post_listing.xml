<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nox_cream_bg">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/nox_dark_green" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/post_item_title_bar"
            android:textColor="@color/nox_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Form Area -->
    <ScrollView
        android:id="@+id/formScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/formContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <!-- Media Upload Box -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAddImage"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/nox_accent_green"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Camera Icon in Circle -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/white_circle_bg">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/nox_dark_green" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnText1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/post_add_media"
                        android:textColor="@color/nox_dark_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/post_media_hint"
                        android:textColor="@color/nox_dark_green"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Thumbnail strip so the seller can review the chosen media. -->
            <TextView
                android:id="@+id/mediaPreviewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/nox_dark_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/mediaPreviewScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/mediaPreviewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/post_title_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etItmName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_search_box"
                android:hint="@string/post_title_hint"
                android:inputType="textCapSentences"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/nox_dark_green"
                android:textColorHint="@color/nox_subtext"
                android:textSize="14sp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_category_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spiCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/spinner_bg"
                android:paddingStart="16dp"
                android:paddingEnd="36dp"
                android:popupBackground="@color/nox_field_bg" />

            <!-- Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_price_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_search_box"
                android:hint="@string/post_price_hint"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/nox_dark_green"
                android:textColorHint="@color/nox_subtext"
                android:textSize="14sp" />

            <!-- Condition -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_condition_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radgroupCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <RadioButton
                    android:id="@+id/radBtnNew"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/condition_chip_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/post_condition_new"
                    android:textColor="@color/condition_chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radBtnLikeNew"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/condition_chip_selector"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/post_condition_like_new"
                    android:textColor="@color/condition_chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radBtnUsed"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/condition_chip_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/post_condition_used"
                    android:textColor="@color/condition_chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_description_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_search_box"
                android:gravity="top|start"
                android:hint="@string/post_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="90dp"
                android:padding="16dp"
                android:textColor="@color/nox_dark_green"
                android:textColorHint="@color/nox_subtext"
                android:textSize="14sp" />

            <!-- Pickup Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/post_location_label"
                android:textColor="@color/nox_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spiLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/spinner_bg"
                android:paddingStart="16dp"
                android:paddingEnd="36dp"
                android:popupBackground="@color/nox_field_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickOnMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/post_pick_on_map"
                android:textColor="@color/nox_primary_green"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_map_pin"
                app:iconGravity="textStart"
                app:iconTint="@color/nox_primary_green"
                app:strokeColor="@color/nox_search_stroke" />

            <TextView
                android:id="@+id/tvPickedLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/nox_chip_bg"
                android:padding="12dp"
                android:textColor="@color/nox_dark_green"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Post Listing Button -->
            <Button
                android:id="@+id/btnPostList"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/nox_primary_green"
                android:text="@string/post_submit"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Anchored Material Bottom Navigation Bar -->
    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
