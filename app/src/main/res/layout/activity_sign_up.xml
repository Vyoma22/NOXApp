<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up screen, styled to match the Figma login frame.
     View IDs are unchanged so SignUpActivity works as before. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nox_cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="8dp"
            android:alpha="0.5"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nox_mark" />

        <!-- Smaller wordmark than login so the form fits -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/nox_logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/nox_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/sign_up_title"
            android:textColor="@color/nox_dark_green"
            android:textSize="22sp" />

        <TextView
            style="@style/NOX.Notice"
            android:layout_marginTop="20dp"
            android:text="@string/student_access_notice" />

        <!-- Name -->
        <TextView
            style="@style/NOX.Label"
            android:labelFor="@id/nameInput"
            android:text="@string/label_full_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.NOX.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                style="@style/Widget.NOX.TextInputEditText"
                android:autofillHints="name"
                android:hint="@string/hint_full_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <TextView
            style="@style/NOX.Label"
            android:labelFor="@id/emailInput"
            android:text="@string/label_student_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailLayout"
            style="@style/Widget.NOX.TextInputLayout"
            app:helperText="@string/email_domains_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                style="@style/Widget.NOX.TextInputEditText"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_student_email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <TextView
            style="@style/NOX.Label"
            android:labelFor="@id/passwordInput"
            android:text="@string/label_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/Widget.NOX.TextInputLayout"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                style="@style/Widget.NOX.TextInputEditText"
                android:autofillHints="newPassword"
                android:hint="@string/hint_new_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm password -->
        <TextView
            style="@style/NOX.Label"
            android:labelFor="@id/confirmInput"
            android:text="@string/label_confirm_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmLayout"
            style="@style/Widget.NOX.TextInputLayout"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmInput"
                style="@style/Widget.NOX.TextInputEditText"
                android:autofillHints="newPassword"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Graduation month / year -->
        <TextView
            style="@style/NOX.Label"
            android:text="@string/label_expected_graduation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/monthSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/nox_field_bg"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/yearSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/nox_field_bg"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <TextView
            android:id="@+id/gradError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/graduation_note"
            android:textColor="@color/nox_subtext"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signUpButton"
            style="@style/Widget.NOX.Button"
            android:layout_marginTop="28dp"
            android:text="@string/create_account" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/nox_primary_green"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToLoginButton"
            style="@style/Widget.NOX.Button.Link"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/already_have_account" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/NOX.Footer"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="@string/verified_students_only" />
    </LinearLayout>
</ScrollView>
