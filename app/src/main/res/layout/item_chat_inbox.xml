<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nox_cream_bg"
    android:orientation="vertical">

    <!-- Conversation row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="86dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Avatar and unread indicator -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <androidx.cardview.widget.CardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/nox_card_green"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/chatInboxAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AC"
                    android:textColor="@color/nox_dark_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <!-- Small unread dot -->
            <View
                android:id="@+id/chatUnreadDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/chat_unread_dot"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Conversation details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatInboxName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Amazon Cat"
                android:textColor="@color/nox_dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatInboxListing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MacBook Air · $550"
                android:textColor="@color/nox_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chatInboxLastMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Perfect, see you then!"
                android:textColor="@color/nox_dark_green"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Message time -->
        <TextView
            android:id="@+id/chatInboxTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="2m"
            android:textColor="@color/nox_subtext"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Horizontal separator only -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/nox_search_stroke" />

</LinearLayout>
