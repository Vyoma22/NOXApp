<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screens swap instantly. Motion lives inside each screen, not between them. -->
    <style name="Animation.NOX.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nox_activity_instant</item>
        <item name="android:activityOpenExitAnimation">@anim/nox_activity_instant</item>
        <item name="android:activityCloseEnterAnimation">@anim/nox_activity_instant</item>
        <item name="android:activityCloseExitAnimation">@anim/nox_activity_instant</item>
    </style>

    <style name="Animation.NOX.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/nox_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/nox_sheet_out</item>
    </style>

    <!-- Five tabs leave 72dp per item; Material's 64dp pill plus its 8dp margins
         touches both edges, so the last pill is clipped. A narrower pill stays round. -->
    <style name="Widget.NOX.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="SettingsSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/nox_subtext</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BrowseFilterButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/browse_filter_pill</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_down</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nox_dark_green</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@null</item>
    </style>
</resources>
