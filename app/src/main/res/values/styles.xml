<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Open: the new screen fades over the old one. Close: the old screen dissolves. -->
    <style name="Animation.NOX.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nox_activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/nox_activity_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/nox_activity_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/nox_activity_exit</item>
    </style>

    <style name="Animation.NOX.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/nox_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/nox_sheet_out</item>
    </style>

    <style name="BrowseFilterButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/browse_filter_pill</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_down</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nox_dark_green</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@null</item>
    </style>
</resources>
