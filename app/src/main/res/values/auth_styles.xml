<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for the auth screens only (applied in LoginActivity / SignUpActivity / VerifyEmailActivity).
         Builds on the app theme so team-wide settings still apply, then pins the light cream look. -->
    <style name="Theme.NOXApp.Auth" parent="Theme.NOXApp">
        <item name="colorPrimary">@color/nox_primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/nox_chip_bg</item>
        <item name="colorOnPrimaryContainer">@color/nox_primary_green</item>
        <item name="colorSecondary">@color/nox_primary_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/nox_field_bg</item>
        <item name="colorOnSurface">@color/nox_dark_green</item>
        <item name="colorOnSurfaceVariant">@color/nox_subtext</item>
        <item name="colorOutline">@color/nox_field_border</item>
        <item name="colorError">@color/nox_error</item>
        <item name="android:colorBackground">@color/nox_cream_bg</item>
        <item name="colorOnBackground">@color/nox_dark_green</item>
        <item name="android:windowBackground">@color/nox_cream_bg</item>
        <item name="android:textColorPrimary">@color/nox_dark_green</item>
        <!-- No fixed status-bar icon colour: edge-to-edge chooses light icons in dark mode. -->
        <!-- Only android:fontFamily: a theme-level app:fontFamily would override the bold styles below. -->
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- ===== Auth screen components ===== -->

    <!-- Empty parent so NOX.Label / NOX.Notice / NOX.Footer resolve -->
    <style name="NOX" />

    <!-- Field label above each input ("Student Email", "Password") -->
    <style name="NOX.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nox_dark_green</item>
    </style>

    <!-- Rounded cream input box, label lives outside (hint becomes the placeholder) -->
    <style name="Widget.NOX.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/nox_field_bg</item>
        <item name="boxStrokeColor">@color/nox_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="endIconTint">@color/nox_subtext</item>
        <item name="helperTextTextColor">@color/nox_subtext</item>
    </style>

    <style name="Widget.NOX.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nox_dark_green</item>
        <item name="android:textColorHint">@color/nox_subtext</item>
    </style>

    <!-- Solid green "Log In" button -->
    <style name="Widget.NOX.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/nox_button_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Cream outlined "Create an Account" button -->
    <style name="Widget.NOX.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/nox_field_bg</item>
        <item name="strokeColor">@color/nox_card_green</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/nox_accent_text</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Small green text link ("Forgot password?") -->
    <style name="Widget.NOX.Button.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/nox_accent_text</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Pale green "Student access only" banner -->
    <style name="NOX.Notice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_notice</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">-1sp</item>
        <item name="android:textColor">@color/nox_accent_text</item>
    </style>

    <style name="NOX.Footer">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nox_subtext</item>
    </style>
</resources>
