<?xml version="1.0" encoding="utf-8"?>
<!-- Makes the graduation Spinners look like the text fields, with a chevron on the right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nox_field_bg" />
            <stroke android:width="1dp" android:color="@color/nox_field_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_spinner_chevron"
        android:end="12dp"
        android:gravity="end|center_vertical" />
</layer-list>
