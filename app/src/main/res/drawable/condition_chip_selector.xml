<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected: solid brand green, legible white label in both light and dark themes. -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nox_primary_green" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Unselected: theme field with a visible outline instead of two similar pastels. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nox_field_bg" />
            <stroke android:width="1.5dp" android:color="@color/nox_search_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
