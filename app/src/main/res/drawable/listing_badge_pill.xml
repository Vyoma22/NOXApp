<?xml version="1.0" encoding="utf-8"?>
<!-- Small pill behind the Popular and price-drop badges. The field background is cream in
     light and near-black in dark, so the pill stays legible on both card colours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/nox_field_bg" />
    <stroke android:width="1dp" android:color="@color/nox_search_stroke" />
    <corners android:radius="8dp" />
</shape>
